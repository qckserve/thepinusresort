{
  "name": "thepinus",
  "private": true,
  "version": "1.0.0",
  "description": "The Pinus Resort, Pahalgam: website (Vite) and booking enquiry backend (Node.js)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n db,web,api -c yellow,green,blue \"node scripts/dev-mongo.mjs\" \"vite --port 5173 --strictPort\" \"npm:dev:api\"",
    "dev:api": "PORT=8787 node --watch --env-file-if-exists=.env server/index.js",
    "dev:db": "node scripts/dev-mongo.mjs",
    "build": "vite build",
    "preview": "npm run build && npm start",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "test": "node --test --test-concurrency=1 test/api.test.mjs"
  },
  "dependencies": {
    "@vercel/functions": "^3.11.0",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "mongodb": "^7.8.0",
    "nodemailer": "^10.3.1"
  },
  "devDependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "concurrently": "^10.0.6",
    "mongodb-memory-server-core": "^11.3.0",
    "vite": "^8.3.6"
  }
}
