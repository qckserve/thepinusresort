# Copy to .env for local use. On Vercel, add the same names under
# Project > Settings > Environment Variables. Never commit .env.

# --- Database (MongoDB Atlas) ---
# Atlas > your cluster > Connect > Drivers. Replace <db_password> with the database user's password.
# Leave empty locally: "npm run dev" starts its own local MongoDB.
MONGODB_URI=
MONGODB_DB=thepinus

# --- Admin panel at /admin/ ---
# On the first admin request an owner account is created from these two (only if no staff exist).
# After that, manage staff inside the admin; changing these does nothing.
ADMIN_EMAIL=thepinusresort@gmail.com
ADMIN_PASSWORD=
# Long random string, e.g. output of: openssl rand -hex 32
SESSION_SECRET=

# --- Scheduled emails (Vercel Cron calls /api/cron with this as a Bearer token) ---
# Long random string. Vercel sends it automatically when this variable exists.
CRON_SECRET=

# --- Email (optional; without it, emails are logged as "skipped") ---
# Gmail: use an App Password (Google Account > Security > App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="The Pinus Resort <thepinusresort@gmail.com>"
MAIL_TO=thepinusresort@gmail.com

# Public address used in email links (review page, admin link, logo)
PUBLIC_URL=https://thepinusresort.com

# Local only: write emails as .html files into this folder instead of sending them
# MAIL_PREVIEW_DIR=./mail-previews
# Node hosts only (not Vercel): set to 1 to stop the built-in 10-minute job timer
# DISABLE_JOBS=1
# Node hosts only: port to listen on (most hosts set this for you)
# PORT=8787
