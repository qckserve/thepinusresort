# Copy to .env and fill in. Never commit .env.

# Port the Node server listens on (most hosts set this for you)
PORT=8787

# Admin panel at /admin/
# On first start, an owner account is created from these two (if no staff exist yet).
# After that, manage staff in the admin under Staff; changing these does nothing.
ADMIN_EMAIL=thepinusresort@gmail.com
ADMIN_PASSWORD=
# Long random string, e.g. output of: openssl rand -hex 32
SESSION_SECRET=

# Email notifications for new enquiries (optional; enquiries are saved either way)
# Gmail: use an App Password (Google Account > Security > App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="The Pinus Resort <thepinusresort@gmail.com>"
MAIL_TO=thepinusresort@gmail.com

# Public address used in email links (review page, admin link, logo)
PUBLIC_URL=https://thepinusresort.com

# Set to 1 to stop the background jobs (selling window, check-out and review emails)
# DISABLE_JOBS=1

# Where enquiries are stored (default: data/pinus.db)
# DB_FILE=/home/user/pinus-data/pinus.db
